Bootstrap: docker
From: rocker/r-ver:4.3.2

  # ---------------------------------------------------------------------------
  # Here we have every software tool we have used in the pipeline with the
  # versions it was run with.
  #
  #
  # Build:  sudo apptainer build genotype-qc.sif container/pipeline.def
  # Test:   apptainer test genotype-qc.sif
  #
  #
  # The versions below must match SOFTWARE.md. Note that we do not provide
  # the strand-checking script from Will Rayner's lab since it is on a personal
  # page, and the download URL will change between versions. Perl is in the
  # image, so fetch that one script yourself and it will run.
  # ---------------------------------------------------------------------------


%labels
        Description  Genotype QC, imputation and polygenic scoring
        R            4.3.2
        PLINK1       1.9.0-b.7.11 (2025-08-19)
        PLINK2       v2.0.0-b.1 (2026-10-01)
        BEAGLE       5.5 (27Feb25.75f)
        BREF3        28Jun21.220
        BCFTOOLS     1.18
        PRSICE       2.3.5
        PRSCS        5330390
        PRSCSX       37eaeb3


%environment
        export BEAGLE_JAR=/usr/local/share/beagle.jar
        export BREF_JAR=/usr/local/share/bref3.jar
        export PRSICE_BIN=/usr/local/bin/PRSice_linux
        export PRSCS_DIR=/usr/local/share/PRScs
        export PRSCSX_DIR=/usr/local/share/PRScsx
        export LC_ALL=C


%post
        set -eux
        export DEBIAN_FRONTEND=noninteractive

        apt-get update
        apt-get install -y --no-install-recommends \
            ca-certificates curl unzip git build-essential \
            default-jre-headless perl \
            libcurl4-openssl-dev libssl-dev libxml2-dev \
            zlib1g-dev libbz2-dev liblzma-dev libdeflate-dev libncurses-dev \
            python3 python3-pip python3-numpy python3-scipy python3-h5py
        rm -rf /var/lib/apt/lists/*

        # Everything goes in /usr/local rather than /opt. Some clusters bind their
        # own /opt into the container, which hides anything installed there and
        # gives you "command not found" from an image that plainly contains the
        # command. Nothing binds /usr/local, and it is already on the default PATH.
        mkdir -p /usr/local/bin /usr/local/share

        # --- HTSlib and bcftools, built from source-----------------------------
        # Not from apt: the distribution package is several versions behind, so
        # installing it would put a different bcftools in the image from the one
        # SOFTWARE.md names
        HTSVER=1.18
        for pkg in htslib bcftools; do
          curl -fsSL -o /tmp/$pkg.tar.bz2 \
            "https://github.com/samtools/$pkg/releases/download/${HTSVER}/${pkg}-${HTSVER}.tar.bz2"
          tar xjf /tmp/$pkg.tar.bz2 -C /tmp
          ( cd "/tmp/${pkg}-${HTSVER}" && ./configure --prefix=/usr/local && make -j4 && make install )
        done
        ldconfig

        # --- PLINK 1.9----------------------------------------------------------
        # Needed for three things PLINK 2 does not do: --check-sex in step 1.2,
        # --test-missing in step 1.5, and --flip plus --freq --keep-allele-order in
        # step 1.8.
        curl -fsSL -o /tmp/plink1.zip \
        https://s3.amazonaws.com/plink1-assets/plink_linux_x86_64_20250819.zip
        unzip -q /tmp/plink1.zip -d /tmp/plink1
        install -m 0755 /tmp/plink1/plink /usr/local/bin/plink

        # --- PLINK 2------------------------------------------------------------
        # The 2.00a3.7 build we ran the analysis with (24 Oct 2022) is no longer
        # distributed: PLINK 2 prunes old dated builds from its bucket, so thatURL
        # now returns 404. We therefore pin a current build here. If this URL ever
        # 404s too, take the newest datestamp from the PLINK 2 download page.
        curl -fsSL -o /tmp/plink2.zip \
        https://s3.amazonaws.com/plink2-assets/plink2_linux_x86_64_20261001.zip
        unzip -q /tmp/plink2.zip -d /tmp/plink2
        install -m 0755 /tmp/plink2/plink2 /usr/local/bin/plink2


        # --- Beagle, and the converter for its haplotype format-----------------
        curl -fsSL -o /usr/local/share/beagle.jar \
        https://faculty.washington.edu/browning/beagle/beagle.27Feb25.75f.jar
        curl -fsSL -o /usr/local/share/bref3.jar \
        https://faculty.washington.edu/browning/beagle/bref3.28Jun21.220.jar

        # --- UCSC liftOver------------------------------------------------------
        curl -fsSL -o /usr/local/bin/liftOver \
        https://hgdownload.soe.ucsc.edu/admin/exe/linux.x86_64/liftOver
        chmod 0755 /usr/local/bin/liftOver

        # --- PRSice-2-----------------------------------------------------------
        curl -fsSL -o /tmp/prsice.zip \
        https://github.com/choishingwan/PRSice/releases/download/2.3.5/PRSice_linux.zip
        unzip -q /tmp/prsice.zip -d /tmp/prsice
        install -m 0755 /tmp/prsice/PRSice_linux /usr/local/bin/PRSice_linux

        # --- PRS-CS, PRS-CSx----------------------------------------------------
        # These are distributed as repositories rather than releases, so the commit
        # is what identifies the version. Pinned so a rebuild gets the same code.
        git clone https://github.com/getian107/PRScs.git /usr/local/share/PRScs
        git -C /usr/local/share/PRScs   checkout -q 5330390
        git clone https://github.com/getian107/PRScsx.git /usr/local/share/PRScsx
        git -C /usr/local/share/PRScsx  checkout -q 37eaeb3

        # --- R packages---------------------------------------------------------
        # From a dated snapshot so a rebuild installs these versions, not
        # whatever is current.
        R -e 'options(repos = c(CRAN =
        "https://packagemanager.posit.co/cran/2024-01-15"))
              install.packages(c("data.table", "ggplot2", "scales",
                                 "dplyr", "R.utils", "runonce",
                                 "bigstatsr", "bigsnpr"), Ncpus = 4)'


%test
        set -e
        echo "every tool the pipeline calls, in the order the steps call them"
        plink2 --version
        plink --version | head -1
        liftOver 2>&1 | head -1
        perl --version | sed -n 2p
        bcftools --version | head -1
        java -jar /usr/local/share/beagle.jar 2>&1 | head -1
        PRSice_linux --version 2>&1 | head -1
        python3 -c "import numpy, scipy, h5py; print('python deps OK')"
        python3 /usr/local/share/PRScs/PRScs.py --help > /dev/null 2>&1 || true
        test -f /usr/local/share/PRScsx/PRScsx.py && echo "PRS-CSx present"
        Rscript -e 'for (p in c("data.table","ggplot2","scales","dplyr",
                                "R.utils","bigsnpr","bigstatsr"))
                      stopifnot(requireNamespace(p, quietly = TRUE))
                    cat("R packages OK\n")'
